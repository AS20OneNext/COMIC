# Normalize text files to LF in the repository.
* text=auto eol=lf

# Keep Windows command scripts with CRLF line endings.
*.bat text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
