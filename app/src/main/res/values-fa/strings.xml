    <!-- Welcome / Initial Setup -->
    <string name="welcome_headline">دوبله زنده مستقیم گفتار به گفتار</string>
    <string name="welcome_description">COMIC صدای در حال پخش از برنامه‌های دیگر را دریافت کرده و مستقیماً به مدل Gemini 3.5 Live Translate می‌فرستد تا صدای دوبله‌شده طبیعی و پیوسته پخش شود؛ بدون رونویسی متن یا ذخیره صدا.</string>
    <string name="welcome_api_section_title">پیکربندی کلید Gemini API</string>
    <string name="welcome_permissions_title">مجوزهای مورد نیاز</string>
